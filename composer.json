{
    "name": "shivasaireddy007/shopping-cart-system",
    "description": "Shopping cart ecommerce and shop system",
    "keywords": ["ecommerce", "shop", "laravel", "distribution"],
    "license": "MIT",
    "type": "project",
    "repositories": [{
        "type": "path",
        "url": "packages/*"
    }],
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "aimeos/aimeos-laravel": "~2026.10.1",
        "dedoc/scramble": "^0.13.47",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^12.69",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "php-open-source-saver/jwt-auth": "^2.8",
        "predis/predis": "^2.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.13",
        "laravel/breeze": "^2.3",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi --force",
            "App\\Composer::configure",
            "@php artisan migrate --force",
            "App\\Composer::setup",
            "App\\Composer::account",
            "App\\Composer::success"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi",
            "@php artisan vendor:publish --tag=public --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
