  "components": {
    "schemas": {
      "CartItemIn": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "CartItemIn"
      },
      "CartItemOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit_price": {
            "type": "integer",
            "title": "Unit Price"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "line_total": {
            "type": "integer",
            "title": "Line Total"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_id",
          "sku",
          "name",
          "unit_price",
          "quantity",
          "line_total"
        ],
        "title": "CartItemOut"
      },
      "CartItemUpdate": {
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "quantity"
        ],
        "title": "CartItemUpdate"
      },
      "CartOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartItemOut"
            },
            "type": "array",
            "title": "Items"
          },
          "subtotal": {
            "type": "integer",
            "title": "Subtotal"
          },
          "shipping_fee": {
            "type": "integer",
            "title": "Shipping Fee"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "INR"
          }
        },
        "type": "object",
        "required": [
          "items",
          "subtotal",
          "shipping_fee",
          "total"
        ],
        "title": "CartOut"
      },
      "CategoryCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[a-z0-9-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CategoryCreate"
      },
      "CategoryOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
